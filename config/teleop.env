# config/teleop.env — machine-specific defaults, sourced by run_teleop.sh.
# Every value can also be overridden from the environment or by a command line flag.

# Colcon workspace that holds the Wonik Allegro Hand V6 driver packages
# (allegro_hand_v6_bringup / _description / _hardware + allegro_hand_utility).
ALLEGRO_WS="${ALLEGRO_WS:-$HOME/v6f_manuse_teleoperation}"

# ROS 2 distribution setup script (this machine runs Jazzy natively, no container).
ROS_SETUP="${ROS_SETUP:-/opt/ros/jazzy/setup.bash}"

# Hand network settings. The driver package default is 192.168.40.100, which is NOT this
# hand: the descriptor is always passed explicitly.
HAND_IP="${HAND_IP:-192.168.1.100}"
HAND_PORT="${HAND_PORT:-502}"
HAND_ID="${HAND_ID:-1}"

# Wired interface facing the hand, and the address it must hold.
# Never give the PC 192.168.1.100 itself — it answers its own pings and the hand is
# then unreachable (this cost hours on 2026-09-23).
ETH_IFACE="${ETH_IFACE:-enp129s0}"
PC_IP="${PC_IP:-192.168.1.10/24}"

# Teleop defaults
HAND_SIDE="${HAND_SIDE:-right}"   # 'real' mode auto-detects and overrides this
UI_MODE="${UI_MODE:-cockpit}"     # cockpit | classic | simple | none
RATE="${RATE:-100}"               # command rate to the hand [Hz]
ALPHA="${ALPHA:-0.25}"            # EMA low-pass coefficient in sim_bridge_node
FPS="${FPS:-60}"                  # camera capture rate
SCALE="${SCALE:-1.75}"            # window scale for --simple-gui
DEVICE="${DEVICE:-}"              # camera index; empty = auto-detect

# Dataset recorder output (used by --record)
AVT_EPISODE_DIR="${AVT_EPISODE_DIR:-}"   # empty = <repo>/data/episodes
